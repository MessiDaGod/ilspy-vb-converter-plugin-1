<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- ILSpy discovers plugins by filename -->
    <AssemblyName>ILSpy.VB.Plugin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Your direct deps -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0" />
    <PackageReference Include="ICSharpCode.CodeConverter" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILSpy\ILSpy.csproj" />
    <ProjectReference Include="..\ICSharpCode.ILSpyXaml\ICSharpCode.ILSpyXaml.csproj" />
    <ProjectReference Include="..\ICSharpCode.Decompiler\ICSharpCode.Decompiler.csproj" />
  </ItemGroup>

</Project>
